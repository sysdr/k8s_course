{
  "dashboard": {
    "title": "PostgreSQL Production Dashboard",
    "tags": ["postgres", "database"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Database Connections",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"appdb\"}",
            "legendFormat": "Active Connections"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "title": "Transaction Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit{datname=\"appdb\"}[5m])",
            "legendFormat": "Commits/sec"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback{datname=\"appdb\"}[5m])",
            "legendFormat": "Rollbacks/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "title": "Cache Hit Ratio",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "(sum(pg_stat_database_blks_hit{datname=\"appdb\"}) / (sum(pg_stat_database_blks_hit{datname=\"appdb\"}) + sum(pg_stat_database_blks_read{datname=\"appdb\"}))) * 100"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
      },
      {
        "title": "Query Duration P95",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Duration"
          }
        ],
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8}
      }
    ]
  }
}
