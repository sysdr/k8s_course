{
  "dashboard": {
    "title": "Log Processor Observability",
    "tags": ["kubernetes", "observability", "debugging"],
    "timezone": "browser",
    "panels": [
      {
        "title": "HTTP Request Duration (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Log Processing Rate",
        "targets": [
          {
            "expr": "rate(log_entries_processed_total[1m])",
            "legendFormat": "{{severity}} {{source}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Active Processing Jobs",
        "targets": [
          {
            "expr": "active_processing_jobs",
            "legendFormat": "Active Jobs"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Error Rate",
        "targets": [
          {
            "expr": "rate(log_parse_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "type": "graph"
      }
    ]
  }
}
