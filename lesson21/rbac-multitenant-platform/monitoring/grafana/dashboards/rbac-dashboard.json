{
  "dashboard": {
    "title": "RBAC Analytics Dashboard",
    "panels": [
      {
        "id": 1,
        "title": "Total RBAC Resources",
        "type": "stat",
        "targets": [
          {
            "expr": "count(kube_role_info)"
          }
        ]
      },
      {
        "id": 2,
        "title": "ServiceAccount Permissions",
        "type": "table",
        "targets": [
          {
            "expr": "kube_role_binding_info"
          }
        ]
      },
      {
        "id": 3,
        "title": "Permission Checks Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(rbac_permission_checks_total[5m])"
          }
        ]
      }
    ]
  }
}
