{
  "title": "Global Log Platform — Traffic Distribution",
  "uid":   "glp-traffic-001",
  "tags":  ["kubernetes", "global-load-balancer", "istio"],
  "panels": [
    {
      "id": 1,
      "title": "Ingestion Rate by Region",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(log_ingestion_total[1m])) by (region)",
          "legendFormat": "{{region}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "P99 Ingestion Latency by Region",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(log_ingestion_duration_seconds_bucket[5m])) by (le, region))",
          "legendFormat": "P99 {{region}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Active Istio Endpoint Ejections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(envoy_cluster_outlier_detection_ejections_active)",
          "legendFormat": "Ejected endpoints"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "HPA Replica Count — Log Ingestion",
      "type": "graph",
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=~\".*log-ingestion.*\"}",
          "legendFormat": "{{namespace}} current replicas"
        }
      ],
      "gridPos": {"h": 4, "w": 18, "x": 6, "y": 8}
    }
  ],
  "schemaVersion": 30,
  "version": 1
}
