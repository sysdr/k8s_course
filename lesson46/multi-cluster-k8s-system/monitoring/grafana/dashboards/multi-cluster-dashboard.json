{
  "dashboard": {
    "title": "Multi-Cluster Kubernetes Overview",
    "tags": ["kubernetes", "multi-cluster", "karmada"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Cluster Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "count(up{job=\"kubernetes-apiservers\"} == 1)",
            "legendFormat": "Healthy Clusters"
          }
        ]
      },
      {
        "title": "Cross-Cluster Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(istio_requests_total{destination_cluster!=\"source_cluster\"}[5m])) by (source_cluster, destination_cluster)",
            "legendFormat": "{{source_cluster}} -> {{destination_cluster}}"
          }
        ]
      },
      {
        "title": "Pod Distribution by Cluster",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "count(kube_pod_info{namespace=\"default\"}) by (cluster)",
            "legendFormat": "{{cluster}}"
          }
        ]
      },
      {
        "title": "Karmada Propagation Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(karmada_resource_propagation_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ]
      }
    ]
  }
}
