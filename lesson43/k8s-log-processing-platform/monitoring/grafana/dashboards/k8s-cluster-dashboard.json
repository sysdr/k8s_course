{
  "dashboard": {
    "title": "Kubernetes Cluster Overview",
    "panels": [
      {
        "title": "Pod CPU Usage",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"log-platform\"}[5m])) by (pod)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Pod Memory Usage",
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace=\"log-platform\"}) by (pod)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Log Ingestion Rate",
        "targets": [
          {
            "expr": "rate(log_ingestion_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Error Rate",
        "targets": [
          {
            "expr": "rate(log_ingestion_total{level=\"ERROR\"}[5m])"
          }
        ],
        "type": "graph"
      }
    ]
  }
}
